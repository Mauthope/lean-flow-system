# =============================================================================
# LEAN FLOW SYSTEM - CONFIGURAÇÃO DE AMBIENTE (SUPABASE & GOVERNANÇA)
# =============================================================================

# 1. Conexão com o Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

# 2. Usuário Root Master de Inicialização
MASTER_INITIAL_EMAIL=mauricio.grigol@rafitec.com.br

# 3. Provedores de Inteligência Artificial (Chaves Privadas de Servidor - NUNCA expor com NEXT_PUBLIC_)
# Suporte agnóstico: Chave genérica corporativa ou provedores específicos (Gemini, OpenAI, Claude, etc.)
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. Notificações Transacionais Corporativas (Microsoft Graph API / M365)
# Obtidos junto à TI / Microsoft Entra ID (App Registration com Mail.Send restrito por caixa)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAIL_SENDER=leanflow@vaccaro.com.br
# Chave de segurança: Mantenha 'false' em desenvolvimento para simular sem disparar e-mails reais
EMAIL_ENABLED=false
